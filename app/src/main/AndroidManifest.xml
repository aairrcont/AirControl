<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera (front camera for hand tracking) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="true" />

    <!-- Foreground service with camera type (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Media & audio controls -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Draw overlay for floating gesture indicator bubble -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Vibration for haptic gesture feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Receive phone call state for call controls -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Broadcast receiver for media button events -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL"
        android:requiredFeature="android.software.leanback"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools"/>

    <!-- Wake lock: keep CPU on when gesture service is running in background -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Post notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AirControlApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AirControl"
        android:supportsRtl="true">

        <!-- Main launcher activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gesture configuration activity -->
        <activity
            android:name=".ui.GestureConfigActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:label="@string/gesture_config_title" />

        <!-- Calibration activity -->
        <activity
            android:name=".ui.CalibrationActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:label="@string/calibration_title" />

        <!-- Foreground service: runs camera and hand tracking -->
        <service
            android:name=".service.GestureService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Accessibility service: executes all phone actions -->
        <service
            android:name=".service.AirAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="@string/accessibility_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Broadcast receiver for media button (play/pause from gesture) -->
        <receiver
            android:name=".service.MediaButtonReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
