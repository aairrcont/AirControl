<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Mini Floating Orb (Default View) -->
    <RelativeLayout
        android:id="@+id/bubbleView"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/hud_bubble_bg"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Glowing gesture icon / symbol -->
        <TextView
            android:id="@+id/tvHudIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="🖐️"
            android:textSize="22sp" />

        <!-- Tiny tracking presence indicator dot -->
        <View
            android:id="@+id/viewTrackingDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="5dp"
            android:background="@drawable/ic_launcher_round" />
    </RelativeLayout>

    <!-- Expanded Futuristic Cyberpunk HUD Dialog (Tapped View) -->
    <LinearLayout
        android:id="@+id/panelExpanded"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:background="@drawable/hud_panel_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:elevation="16dp"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AIRCONTROL // HUD"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnCollapseHud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Status display -->
        <TextView
            android:id="@+id/tvHudStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STATUS: TRACKING"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvHudLastAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAST ACTION: NONE"
            android:textColor="#F1F5F9"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHudOpenApp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="App"
                android:textSize="11sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnHudStop"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Stop"
                android:textSize="11sp"
                android:textColor="#F87171"
                android:padding="0dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
