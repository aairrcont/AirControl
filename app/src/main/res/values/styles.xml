<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: dark Material3 -->
    <style name="Theme.AirControl" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Entry</item>
    </style>

    <!-- Full screen / splash (no action bar) -->
    <style name="Theme.AirControl.NoBar" parent="Theme.AirControl">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
